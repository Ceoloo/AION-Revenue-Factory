# AION Outreach Engine — example environment.
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Every value here is optional: with none set, the engine runs fully offline
# (synthetic leads, template AI, console/dry-run provider). Add credentials to
# take one integration live at a time.

# ---- app ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- safety (defaults are the safe values) ----
# No real email leaves the building unless this is explicitly false.
OUTREACH_DRY_RUN=true
# If set, all sends redirect here; the real recipient is preserved in metadata.
TEST_EMAIL_ADDRESS=

# ---- sending policy ----
# Conservative default. The engine refuses to exceed this per day.
MAX_DAILY_SENDS=100
DEFAULT_TIMEZONE=UTC
# Local sending window (24h HH:MM). Default Mon-Fri 08:30-16:30.
OUTREACH_WINDOW_START=08:30
OUTREACH_WINDOW_END=16:30
# Retry policy for transient send failures.
OUTREACH_MAX_ATTEMPTS=3
OUTREACH_RETRY_BASE_SECONDS=60

# ---- email provider ----
# console (dry-run) | resend | ses. Leave blank to infer from credentials.
EMAIL_PROVIDER=
EMAIL_FROM=outreach@yourdomain.com
EMAIL_REPLY_TO=replies@yourdomain.com
OUTREACH_SENDER_NAME=AION
OUTREACH_SENDER_COMPANY=AION Systems
OUTREACH_BOOKING_LINK=

# Resend (V1)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ---- CRM: Airtable (source of truth for leads/revenue) ----
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_LEADS_VIEW=

# ---- operational store (optional; defaults to in-memory) ----
DATABASE_URL=

# ---- AI ----
# Reuses the existing AION AI gateway. anthropic | (blank -> offline template).
AI_PROVIDER=
ANTHROPIC_API_KEY=
AION_LLM_MODEL=claude-opus-4-8
